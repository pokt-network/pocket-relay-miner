# Environment file for the relayer and miner units. Copy it once per unit:
#   sudo install -m 0600 -o pocket-relay-miner pocket-relay-miner.env.example /etc/pocket-relay-miner/relayer.env
#   sudo install -m 0600 -o pocket-relay-miner pocket-relay-miner.env.example /etc/pocket-relay-miner/miner.env
# then set the values for each process.

# Go runtime soft memory limit: about 10% below the unit's MemoryMax
# (relayer unit: MemoryMax=4G, miner unit: MemoryMax=8G).
# relayer.env: 3600MiB. miner.env: 7200MiB.
GOMEMLIMIT=3600MiB
# Equal to the unit's CPUQuota / 100% (CPUQuota=400% -> 4).
GOMAXPROCS=4

# Only with keys.keyring.backend "file" and keys.keyring.passphrase_env set to
# "KEYRING_PASSPHRASE" in the YAML config. Never put the passphrase in the YAML.
#KEYRING_PASSPHRASE=
