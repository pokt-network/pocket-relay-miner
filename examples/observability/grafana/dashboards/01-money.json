        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 6,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": -1e-09
              },
              {
                "color": "red",
                "value": 1e-09
              }
            ]
          },
          "unit": "suffix: POKT"
