      "description": "Redis maxmemory minus used memory in high-availability mode; free space on the disk of the embedded store in standalone mode. Gates close below 1 GiB free, or below 1/8 of maxmemory (in standalone mode 1/8 of the disk) when that is smaller, and reopen half that line (ingestion) or all of it (admission) above it: 512 MiB / 1 GiB at the full 1 GiB.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 1073741824
              },
              {
                "color": "green",
                "value": 1610612736
              }
